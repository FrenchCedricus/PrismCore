{
  "name": "prismcore",
  "productName": "PrismCore",
  "version": "1.0.0",
  "description": "Suite d'éclairage RGB locale et libre : sans compte, sans télémétrie, sans abonnement.",
  "license": "MIT",
  "author": "PrismCore",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "start:hidden": "electron . --hidden",
    "cli": "node index.js",
    "scan": "node index.js scan",
    "test:dry": "node index.js test",
    "daemon": "node --experimental-vm-modules --no-warnings src/daemon.js",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/make-icon.mjs && electron-builder --win --x64"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.prismcore.app",
    "productName": "PrismCore",
    "copyright": "PrismCore contributors — licence MIT",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "app/**",
      "src/**",
      "drivers/**",
      "index.js",
      "package.json",
      "LICENSE",
      "!**/.cache/**",
      "!node_modules/node-hid/prebuilds/HID-darwin*/**",
      "!node_modules/node-hid/prebuilds/HID-linux*/**",
      "!node_modules/node-hid/prebuilds/HID_hidraw*/**",
      "!node_modules/node-hid/src/**",
      "!node_modules/node-hid/hidapi/**"
    ],
    "asarUnpack": [
      "src/**",
      "drivers/**",
      "node_modules/node-hid/**",
      "node_modules/pkg-prebuilds/**",
      "node_modules/node-addon-api/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "PrismCore-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrismCore",
      "artifactName": "PrismCore-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PrismCore-Portable-${version}.${ext}"
    }
  }
}
